{
  "info": {
    "name": "Support Ticket Management System API",
    "description": "Covers registration, login, ticket CRUD, comments, and access-control cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "customerToken", "value": "" },
    { "key": "agentToken", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer (successful registration)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('customerToken', body.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman.customer@test.com\",\n  \"password\": \"Password123!\"\n}" }
          }
        },
        {
          "name": "Login - success",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token present', () => pm.expect(pm.response.json().token).to.exist);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.customer@test.com\",\n  \"password\": \"Password123!\"\n}" }
          }
        },
        {
          "name": "Login - invalid credentials",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.customer@test.com\",\n  \"password\": \"wrong-password\"\n}" }
          }
        },
        {
          "name": "Login as agent (pre-seeded via npm run seed)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('agentToken', body.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"Password123!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('ticketId', body.ticket.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/tickets",
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Postman test ticket\",\n  \"description\": \"Created from the Postman collection\",\n  \"priority\": \"medium\"\n}" }
          }
        },
        {
          "name": "Get tickets (customer - own tickets only)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "Get ticket by ID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Update ticket (agent - status)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}" }
          }
        },
        {
          "name": "Unauthorized request (no token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "Forbidden - customer updating status (agent-only field)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 - status silently ignored for customer role', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Updated subject by customer\"\n}" }
          }
        },
        {
          "name": "Invalid input - create ticket without subject",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/tickets",
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Missing subject field\"\n}" }
          }
        },
        {
          "name": "Not-found ticket",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/tickets/999999"
          }
        }
      ]
    }
  ]
}
